{#=====================================================
Login Form
=====================================================#}

<article>

    <h1>Login to Abode and Appetite</h1>

    <form hx-post="/login" hx-target="#floating_form" hx-swap="innerHTML" id="login_form">

        <input type="email" name="email" placeholder="Email" required>

        <input type="password" name="password" placeholder="Password" required>

        <div class="form_buttons">
            <button class="button submit_button">Login</button>
            <button class="button delete_button" type="button" hx-get="/close" hx-target="#floating_form" hx-swap="innerHTML">
                Cancel
            </button>
        </div>

    </form>

</article>