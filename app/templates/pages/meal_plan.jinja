{#=====================================================
  Meal Plan
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block content %}

    <h1>Meal Plan</h1>

    {% if plans %}
        <ul>
            {% for meal in plans %}
                
                {{ meal.date|week_start }} - {{ meal.date|week_end }}

                Meal date:
                {{ meal.date }}
            
                <li>
                    <strong>{{ meal.title }}</strong>:

                    <a href="/recipe/{{ meal.recipe_id }}">
                        {{ meal.recipe_title }}
                    </a>

                    <form action="/meal_plan/delete/" method="post">
                        <input type="hidden" name="date" value="{{ meal.date }}">
                        <input type="hidden" name="meal_type" value="{{ meal.meal_type }}">
                        <button type="submit">Delete</button>
                    </form>
                </li>
            {% endfor %}

        </ul>
            
      

    {% else %}

        <p>No meals planned yet!</p>

    {% endif %}

    <a href="/meal_plan/new">
        <button type="button">Add Meal</button>
    </a>

    

{% endblock %}