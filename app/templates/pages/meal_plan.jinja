{#=====================================================
Meal Plan
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block content %}

<div class="meal_plan_container">

    <div class="meal_plan_header">
        <h1>Meal Plan</h1>
        <p>{{ start_date.format("DD/MM/YYYY") }} - {{ end_date.format("DD/MM/YYYY") }}</p>
    </div>

    <div class="week_container">
        {% for i in range(7) %}

        <div class="day_card">
            {# plans[i] is plans in a day at i week date#}
            {% if plans[i] %}

            <ul>
                {% for meal in plans[i] %}

                <li>
                    <strong>{{ meal.meal_type }}</strong>:

                    <a href="/recipe/{{ meal.recipe_id }}">
                        {{ meal.recipe_title }}
                    </a>

                    <form action="/meal_plan/delete/" method="post">
                        <input type="hidden" name="date" value="{{ meal.date }}">
                        <input type="hidden" name="meal_type" value="{{ meal.meal_type }}">
                        <button type="submit">Delete</button>
                    </form>
                </li>

                {% endfor %}
            </ul>

            {% else %}

            <p>No meal planned</p>

            {% endif %}

            {% endfor %}
        </div>

    </div>

    <a href="/meal_plan/new">
        <button type="button">Add Meal</button>
    </a>

</div>
{% endblock %}