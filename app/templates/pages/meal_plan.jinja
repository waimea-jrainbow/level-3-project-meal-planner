{#=====================================================
Meal Plan
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block content %}

<div class="meal_plan_container">

    <div class="meal_plan_header">
        <h1>Meal Plan</h1>
        <p>{{ start_date.format("DD/MM/YYYY") }} - {{ end_date.format("DD/MM/YYYY") }}</p>
    </div>

    <div class="meal_plan_buttons">
        <a class="button submit_button" href="/meal_plan/new">
            Add Meal
        </a>

        <a class="button submit_button" href="/recipes">
            Manage recipes
        </a>
    </div>

    <div class="week_container">
        {% for i in range(0, 7) %}

        <div class="day_card_plan">

            <div class="day_header">
                <p>{{ week_dates[i].format('dddd') }}</p>
                <p>{{ week_dates[i].format("DD/MM/YYYY") }}</p>
            </div>

            <div class="day_content">
                {# plans[i] is plans in a day at i week date #}
                {% if plans[i] %}

                <ul class="meal_list">
                    {% for meal in plans[i] %}

                    <li class="meal">

                        <p>{{ meal.meal_type }}</p>
                        <a class="recipe_title" href="/recipe/{{ meal.recipe_id }}">
                            {{ meal.recipe_title }}
                        </a>

                        <form action="/meal_plan/delete/" method="post">
                            <input type="hidden" name="date" value="{{ meal.date }}">
                            <input type="hidden" name="meal_type" value="{{ meal.meal_type }}">
                            <button class="button clickable delete_button" type="submit"><img
                                    src="{{ url_for('static', filename='images/icons/trash_red.svg') }}"
                                    alt="Delete meal from meal plan"></button>
                        </form>
                    </li>

                    {% endfor %}
                </ul>

                {% else %}

                <p>No meal planned</p>

                {% endif %}
            </div>

        </div>

        {% endfor %}
        <div class="meal_plan_buttons">
            <a class="button submit_button" href="/meal_plan/new">
                Add Meal
            </a>
        </div>

    </div>
</div>
{% endblock %}