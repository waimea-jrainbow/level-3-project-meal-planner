
{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block content %}

<div
    id="floating_form"
    class="modal-overlay"
    hx-get="/close"
    hx-trigger="click[target === this]"
    hx-target="#floating_form"
    hx-swap="innerHTML"></div>

<!-- Hero section -->
<section class="hero">
        
    <div class="hero-content">
        <p>Simple and easy meal
        planning for your
        household</p>

        <a  class="button" 
            type="button"
            hx-get="/user/new"
            hx-target="#floating_form"
            hx-swap="innerHTML">
            Start your meal plan
        </a>
    </div>

</section>

<!-- Hero image credit -->
<p class="image-credit">
    Image by
    <a href="https://www.magnific.com/free-photo/happy-multigeneration-family-having-lunch-together-home-senior-woman-is-bringing-food-table_26652195.htm"
       target="_blank"
       rel="noopener noreferrer">
        Drazen Zigic on Magnific
    </a>
</p>


<!-- How it works -->
<section class="steps">

    <article class="step-card">
        <span class="step-number">1</span>
        <p>Find a recipe and add it to your recipe book.</p>
    </article>

    <article class="step-card">
        <span class="step-number">2</span>
        <p>Add your favourite recipes to your meal plan.</p>
    </article>

    <article class="step-card">
        <span class="step-number">3</span>
        <p>Cook, share and enjoy your meals together.</p>
    </article>

</section>

<!-- Call to action -->
<section class="home-cta">
    <h2>Never wonder what's for dinner again</h2>

    <a class="button" 
        type="button"
        hx-get="/user/new"
        hx-target="#floating_form"
        hx-swap="innerHTML">
            Start your meal plan
    </a>
</section>


<!-- Meal plan examples -->
<section class="meal_plan_examples">
    <div class="meal_plan_section_title_example">
        <h2>A little planning goes a long way</h2>
        <p>Here's what a week of easier dinners could look like.</p>
    </div>

    {# Monday #}
    <div class="meal_plan_day_example">
        <div class="meal_plan_day_label_example">MON</div>
        <div class="meal_plan_title_example">Creamy tomato pasta</div>
    
    </div>

    {# Tuesday #}
    <div class="meal_plan_day_example">
        <div class="meal_plan_day_label_example">TUE</div>
        <div class="meal_plan_title_example">Roast chicken and vegetables</div>
    
    </div>

    {# Wednesday #}
    <div class="meal_plan_day_example">
        <div class="meal_plan_day_label_example">WED</div>
        <div class="meal_plan_title_example">Homemade tacos</div>
    
    </div>

    {# Thursday #}
    <div class="meal_plan_day_example">
        <div class="meal_plan_day_label_example">THU</div>
        <div class="meal_plan_title_example">Vegetable curry</div>
    
    </div>

    {# Friday #}
    <div class="meal_plan_day_example">
        <div class="meal_plan_day_label_example">FRI</div>
        <div class="meal_plan_title_example">Homemade burgers</div>
    
    </div>

</section>


{% endblock %}
