{#=====================================================
Recipe page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

<div class="recipe_detail_container">

    <h1 class="title">{{ recipe.title }}</h1>


    <article class="recipe_detail_card">

        {# Image #}
        {% if recipe.image_path %}
        <div class="recipe_image_container">
            <img src="{{ recipe.image_path }}" alt="{{ recipe.title }}" class="recipe_image">
        </div>
        {% endif %}

        {# Notes #}
        {% if recipe.notes %}
        <div class="recipe_notes_box">
            <p class="recipe_notes"><strong>Notes:</strong> {{ recipe.notes }}</p>
        </div>
        {% endif %}

        <div class="recipe_main_detail">

            {% if recipe.url %}



            <div class="recipe_link">
                <a href="{{ recipe.url}}" target="_blank" class="button clickable">
                    View original recipe↗
                </a>
            </div>

            {% else %}

            <div class="manual_recipe_section">
                <h2>Ingredients</h2>
                <ul>
                    {% for ingredient in recipe.ingredients.splitlines() %}
                    <li>{{ ingredient }}</li>
                    {% endfor %}
                </ul>
            </div>

            <div class="manual_recipe_section">
                <h2>Method</h2>
                <ol>
                    {% for step in recipe.method.splitlines() %}
                    <li>{{ step }}</li>
                    {% endfor %}
                </ol>

            </div>

            {% endif %}
        </div>
            <a href="/dashboard"><button class="button clickable submit_button">Back to Dashboard</button></a>
    </article>

</div>
{% endblock %}