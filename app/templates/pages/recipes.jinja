{#=====================================================
Recipes page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

<section class="manage_recipes">

    <h1 class="recipes_title">Recipes</h1>


    <article class=recipes>

        <ul>
            {% for recipe in recipes %}

            <li>
                <img src="{{ recipe.image_path }}">
                <a href="/recipe/{{ recipe.id }}">
                    {{ recipe.title }}    
                </a>
            


            <a href="/recipe/delete/{{ recipe.id }}">delete</a>

            </li>
            {% else %}

            <p>None!</p>

            {% endfor %}
        </ul>

    </article>
</section>

    {% endblock %}