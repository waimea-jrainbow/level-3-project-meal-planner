{#=====================================================
Recipes management page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

<section class="manage_recipes">

    <h1 class="title">Recipes</h1>
    {% if recipes %}
    <div class="recipe_grid">
        {% for recipe in recipes %}
        <article class="recipe_card">
            <a href="/recipe/{{ recipe.id }}" class="recipe_card_link">
                <h2 class="title">{{ recipe.title }}</h2>
                <img src="{{ recipe.image_path }}" class="recipe_card_image" alt="Recipe_image">
                

            </a>
            <div class="recipe_card_actions">
                <a href="/recipe/delete/{{ recipe.id }}" class="button button delete_button">
                    <img src="{{ url_for('static', filename='images/icons/trash_red.svg') }}" alt="Delete meal">
                </a>
            </div>


        </article>
        {% endfor %}
    </div>
    {% else %}
    <p class="empty_state">No recipes yet. <a href="/recipe/new">Add one!</a></p>
    {% endif %}
</section>

{% endblock %}