{#=====================================================
Manage household page
=====================================================#}
{% extends 'pages/_base.jinja' %}

{% block content %}

<div class="household_container">

    <h1 class="title">{{ household.name }}</h1>

    <div class="members_card">
        <h2>Members</h2>

        {% if members %}

        {% for member in members %}



        <div class="member_info">

            {% if member.role == "owner" %}
            <img src="{{ url_for('static', filename='images/icons/crown_gold.svg') }}" alt="Owner">
            {% else%}
            <img src="{{ url_for('static', filename='images/icons/user.svg') }}" alt="Owner">
            {% endif %}

            <p>
                {{ member.display_name }}
            </p>

            <p>
                {{ member.email }}
            </p>

            {% if is_owner %}
            <div class="member_actions_wrapper">
                {% if is_owner and member.role != "owner" %}

                <form method="POST" action="/household/transfer_owner/{{ member.id }}"
                    onsubmit="return confirm('Transfer ownership to {{ member.display_name }}?');">
                    <button type="submit" class=" button clickable transfer_ownership_button">
                        <img src="{{ url_for('static', filename='images/icons/crown_gray.svg') }}"
                            alt="Transfer ownership">
                    </button>
                </form>

                <form method="POST" action="/household/remove_member/{{ member.id }}"
                    onsubmit="return confirm('Remove {{ member.display_name }} from this household?');">
                    <button type="submit" class=" button clickable delete_button">
                        <img src="{{ url_for('static', filename='images/icons/trash_red.svg') }}" alt="Delete meal">
                    </button>
                </form>

                {% endif %}
            </div>
            {% endif %}
        </div>






        {% endfor %}

        {% else %}

        <p>No members found</p>

        {% endif %}
    </div>

    <section class="join_code_card">
        <label class="join_code_label">Join code</label>
        <div class="join_code_box">
            <button type="button" class="button clickable" hx-get="/household/copy_flash"
                hx-on:click="navigator.clipboard.writeText('{{ household.join_code }}');" title="Copy code">
                <img src="{{ url_for('static', filename='images/icons/copy.svg') }}" alt="Copy">
            </button>
            <p class="join_code_input">{{ household.join_code }}</p>

            {% if is_owner %}
            <form method="POST" action="/household/regenerate_code"
                onsubmit="return confirm('Regenerate join code? The current code will no longer work.');">
                <button type="submit" class="button clickable delete_button" title="Regenerate code">
                    <img src="{{ url_for('static', filename='images/icons/refresh_red.svg') }}" alt="Reset code">
                </button>
            </form>


            {% else %}
            <!-- Spacer to maintain balance when non-owner -->
            <div style="width: 2.2rem;"></div>
            {% endif %}
        </div>
    </section>


    {% if not is_owner %}
    <div class="danger_zone">

        <h2>Delete household</h2>

        <p class="danger_text">
            Leaving will remove your access to this household's meal plans. You will need a join code to rejoin.
        </p>

        <form method="POST" action="/household/leave"
            onsubmit="return confirm('Are you sure you want to leave this household?');">
            <button type="submit" class="button clickable delete_button">
                Leave household
            </button>
        </form>

    </div>
    {% endif %}



    {% if is_owner %}

    <div class="danger_zone">


        <h2>Delete household</h2>

        <p class="danger_text">
            Deleting this household will permanently remove all members and meal plans. This action cannot be undone.
        </p>

        <form method="POST" action="/household/delete/{{ household.id }}"
            onsubmit="return confirm('Are you sure you want to permanently delete this household? This cannot be undone.');">
            <button type="submit" class="button clickable delete_button">
                Delete household
            </button>
        </form>
    </div>
    {% endif %}

</div>

</div>

{% endblock %}