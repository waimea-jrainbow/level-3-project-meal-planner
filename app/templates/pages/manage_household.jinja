{#=====================================================
  Manage household 
=====================================================#}
{% extends 'pages/_base.jinja' %}

{% block content %}

<div>

    <h1>{{ household.name }}</h1>

    

    <h2>Household information</h2>

    <p>
        <strong>Join code:</strong>
        {{ household.join_code }}
        </p>

        <p>
            Share this code with people you want to invite to your household.
        </p>

    </section>


        <h2>Members</h2>

        {% if members %}

            {% for member in members %}

                <div class="member">

                    <div class="member-info">

                        <strong>
                            {{ member.display_name }}
                        </strong>

                        <span>
                            {{ member.email }}
                        </span>

                        {% if member.role == "owner" %}
                            <span class="member-role">
                                Owner
                            </span>
                        {% else %}
                            <span class="member-role">
                                Member
                            </span>
                        {% endif %}

                    </div>


                    {% if is_owner and member.role != "owner" %}

                        <form
                            method="POST"
                            action="/household/transfer_owner/{{ member.id }}"
                            onsubmit="return confirm('Transfer ownership to {{ member.display_name }}?');"
                        >
                            <button type="submit">
                                Transfer ownership
                            </button>
                        </form>

                        <form
                            method="POST"
                            action="/household/remove_member/{{ member.id }}"
                            onsubmit="return confirm('Remove {{ member.display_name }} from this household?');"
                        >
                            <button type="submit">
                                Remove
                            </button>
                        </form>

                    {% endif %}


                </div>

            {% endfor %}

        {% else %}

            <p>No members found</p>

        {% endif %}

        <h2>Leave household</h2>

        {% if is_owner %}

        <p>
            The household owner cannot leave the household.
            Remove the household or transfer ownership first.
        </p>

        {% else %}

        <form
            method="POST"
            action="/household/leave"
            onsubmit="return confirm('Are you sure you want to leave this household?');"
        >
        
            <button type="submit">
                Leave household
            </button>
        </form>

{% endif %}


    </section>


</div>

{% endblock %}
