{#=====================================================
Add recipe page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

<div class="add_recipe_container">
    <article class="add_recipe_card">

        <h1 class="title">Add recipe</h1>

        {# TODO if time remaining make add recipe a floating dialog #}

        <div class="recipe_type_toggle">

            <input type="radio" id="toggle_link" name="recipe_mode" class="toggle_radio" autocomplete="off" checked>
            <label for="toggle_link" class="toggle_btn clickable" hx-get="/recipe/fields/link"
                hx-target="#recipe_fields" hx-swap="innerHTML">
                Add with a link
            </label>

            <input type="radio" id="toggle_manual" name="recipe_mode" class="toggle_radio" autocomplete="off">
            <label for="toggle_manual" class="toggle_btn clickable" hx-get="/recipe/fields/manual"
                hx-target="#recipe_fields" hx-swap="innerHTML">
                Add manually
            </label>

        </div>



        <form action="/recipe" method="POST" enctype="multipart/form-data" id="add_recipe_form">

            <div class="form_section">
                <label for="title">
                    Name of the recipe
                </label>
                <input type="text" name="title" placeholder="Name of the recipe" required>
            </div>

            <div id="recipe_fields" class="form_section">
                <label for="link">
                    Link to the recipe
                </label>

                <input type="url" name="link" id="link" placeholder="Link to the recipe" required>

            </div>

            <div class="form_section">
                <label for="image">Recipe image</label>
                <div class="file_upload">
                    <div class="recipe_image">
                        <input name="image" type="file" accept="image/png, image/jpeg, image/webp" id="image" required>
                    </div>
                    <button type="button" class="button clickable delete_button" hx-get="/recipe/image_reset"
                        hx-target="#recipe_image" hx-swap="innerHTML">
                        Clear image
                    </button>
                </div>
            </div>

            <div class="form_section">
                <label>Notes:</label>
                <textarea name="notes" id="notes" rows="4"
                    placeholder="Optional notes, variations, or tips..."></textarea>
            </div>

            <div class="form_actions">
                <button class="button clickable submit_button">Add the recipe</button>
            </div>
        </form>

    </article>

</div>

{% endblock %}