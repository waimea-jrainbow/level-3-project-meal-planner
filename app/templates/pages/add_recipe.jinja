{#=====================================================
 Add recipe page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}


    <article>

        <h1>Add recipe</h1>

        <div>

            <button
                type="button"
                hx-get="/recipe/fields/link"
                hx-target="#recipe-fields"
                hx-swap="innerHTML"
            >
                Add with a link
            </button>

            <button
                type="button"
                hx-get="/recipe/fields/manual"
                hx-target="#recipe-fields"
                hx-swap="innerHTML"
            >
                Add manually
            </button>

        </div>



        <form action="/recipe" method="POST" enctype="multipart/form-data" id="add_recipe">

            <input
                type="text"
                name="title"
                placeholder="Name of the recipe"
                required
            >

            <div id="recipe-fields">

                <label for="link">
                    Link to the recipe
                </label>

                <input
                    type="url"
                    name="link"
                    id="link"
                    placeholder="Link to the recipe"
                    required
                >

            </div>
            
            {# TODO add validation that links are real #}

            <input
                name="image"
                type="file"
                accept="image/png, image/jpeg, image/webp"
                id="image"
                required
            >

            {# TODO add clear file button ask Mr Copley#}


            <div>
                <label>
                    <input type="radio" name="meal_type" value="any" checked>
                    Any
                </label>
            </div>

            <div>
                <label>
                    <input type="radio" name="meal_type" value="breakfast">
                    Breakfast
                </label>
            </div>
            

            <div>
                <label>
                    <input type="radio" name="meal_type" value="lunch">
                    Lunch
                </label>
            </div>

            <div>
                <label>
                    <input type="radio" name="meal_type" value="dinner">
                    Dinner
                </label>    
            </div>

            <button>Add the recipe</button>

        </form>

    </article>

{% endblock %}

