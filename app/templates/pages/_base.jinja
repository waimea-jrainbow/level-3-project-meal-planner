{#=====================================================
  Base template
  - Used as the basis of all pages
=====================================================#}

<!DOCTYPE html>

<html lang="en" data-theme="light">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>Abode and Appetite {% block title %}{% endblock %}</title>

    <link rel="icon" href="/static/images/note.svg">

    {# JS #}
    <script src="/static/js/utils.js"></script>
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>

    {# Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Delius+Swash+Caps&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Delius+Swash+Caps&family=Ultra&display=swap" rel="stylesheet">

    {# CSS #}
    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/messages.css">
    <link rel="stylesheet" href="/static/css/styles.css">
    

    
</head>

<body>

    <header>
        {% if session .logged_in %}
            <a href="/dashboard" id="nav_title">
                Abode <br> & <br> Appetite
            </a>

        {% else %}
            <a href="/" id="nav_title">
                Abode <br> & <br> Appetite
            </a>
        {% endif %}

        <nav>
            {% if session.logged_in %}
                Welcome, {{ session.user.display_name }}!

                {% if session.user.household_name %}
                    <a href="/meal_plan">View meal plan</a>
                    <a href="/household/manage">Manage household</a> 
                {% endif %}
                
                
                <a href="/logout">Logout</a>
            {% else %}
                <a class="clickable"
                    hx-get="/login"
                    hx-target="#floating_form"
                    hx-swap="innerHTML">Login</a>
                <a id="sign_up_button" class="button clickable" 
                    type="button"
                    hx-get="/user/new"
                    hx-target="#floating_form"
                    hx-swap="innerHTML">
                    Start your meal plan</a>
            {% endif %}  
        </nav>
    </header>

    {# Show flash messages from any previous events #}
    {% include "partials/messages.jinja" %}

    <main>

        {% block content %}
        {% endblock %}

    </main>


    <footer class="site_footer">

        <a href="/" id="footer_title">
            Abode <br> & <br> Appetite
        </a>

        <nav>
            {% if session.logged_in %}
                <a href="/logout">Logout</a>
            {% else %}
                <a class="clickable"
                    hx-get="/login"
                    hx-target="#floating_form"
                    hx-swap="innerHTML">Login</a>
                <a 
                    class="button clickable" 
                    type="button"
                    hx-get="/user/new"
                    hx-target="#floating_form"
                    hx-swap="innerHTML">
                    Start your meal plan
                </a>
            {% endif %}
        </nav>

    </footer>


</body>

</html>

