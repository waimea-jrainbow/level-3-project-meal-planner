{% extends 'pages/_base.jinja' %}

{% block content %}


<section class="todays_meals">
    <h2>Today's meals</h2>
    <ul>
        {% for meal_type in ["breakfast", "lunch", "dinner"] %}

        <li>
            <strong>{{ meal_type }}</strong>

            {% set meal_exists_ns = namespace(meal_exists=false) %}

            {% for meal in today_plans %}

            {% if meal.meal_type == meal_type %}

            {% set meal_exists_ns.meal_exists = true %}

            <a class="meal_link" href="/recipe/{{ meal.recipe_id }}">
                {{ meal.recipe_title }}
            </a>

            <form action="/meal_plan/delete/" method="post">
                <input type="hidden" name="date" value="{{ meal.date }}">
                <input type="hidden" name="meal_type" value="{{ meal.meal_type }}">
                <button class="delete_button" type="submit">
                    <img src="{{ url_for('static', filename='images/icons/trash_red.svg') }}" alt="Delete meal">
                </button>
            </form>

            {% endif %}

            {% endfor %}

            {% if not meal_exists_ns.meal_exists %}
            <p>No meal planned</p>
            {% endif %}

        </li>
        {% endfor %}
    </ul>
</section>

<nav class="dashboard_actions">
    <a class="dashboard_button" href="/meal_plan">
        Meal plan
    </a>
    <a class="dashboard_button" href="/recipes">
        Manage recipes
    </a>
    <a class="dashboard_button" href="/recipe/new">
        Add new recipe
    </a>
</nav>


<section class="weekly_meals">
    <h2>Current weeks meals</h2>

    <div class="meal_legend">
        <span><span class="dot no_meal"></span> No meal</span>
        <span><span class="dot meal_planned"></span> Meal planned</span>
    </div>

    <div class="week_grid">

        {% for i in range(7) %}

        <div class="day_card">

            <p>{{ week_dates[i].format('dddd') }}</p>

            <div class="day_meals">

                {% for meal_type in ["breakfast", "lunch", "dinner"] %}

                    {% if plans[i] %}
                    {# Initialize namespace to use as persistent variable#}
                        {% set meal_exists_ns = namespace(meal_exists=false) %}

                        {% for meal in plans[i] %}
                            {% if meal.meal_type == meal_type %}
                                {% set meal_exists_ns.meal_exists = true %}
                            {% endif %}
                        {% endfor %}

                        {% if meal_exists_ns.meal_exists %}
                            <span class="meal_indicator planned">
                            {{ meal_type }}
                            </span>
                        {% else %}
                            <span class="meal_indicator no_meal">
                                {{ meal_type }}
                            </span>
                        {% endif %}

                    {% else %}
                        <span class="meal_indicator no_meal">
                            {{ meal_type }}
                        </span>
                    {% endif %}

        {% endfor %}

            </div>

        </div>

        {% endfor %}

    </div>
</section>

{% endblock %}