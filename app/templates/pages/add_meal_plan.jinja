{% extends 'pages/_base.jinja' %}

{% block content %}


<div class="add_recipe_container">

    <article class="add_recipe_card">

        <h1>Add Meal to Meal Plan</h1>

        <form method="POST" action="/meal_plan">

            <div class="form_section">
                <label for="date">Date</label>
                <input type="date" id="date" name="date" required>
            </div>

            <div class="form_section"> 
                
                <label for="meal_type">Meal Type</label>

                <select id="meal_type" name="meal_type" required>
                    <option value="">Choose a meal type</option>
                    <option value="breakfast">Breakfast</option>
                    <option value="lunch">Lunch</option>
                    <option value="dinner">Dinner</option>
                </select>
            </div>

            <div class="form_section">
                <label for="recipe_id">Recipe</label>

                <select id="recipe_id" name="recipe_id" required>
                    <option value="">Choose a recipe</option>

                    {% for recipe in recipes %}

                    <option value="{{ recipe.id }}">
                        {{ recipe.title }}
                    </option>

                    {% endfor %}

                </select>
            </div>

            <div class="form_actions"> 
                <button type="submit" class="button submit_button">
                    Add Meal
                </button>
            </div>
        </form>

    </article>

    <div class="form_actions">
        <a class="button submit_button" href="/meal_plan">Back to Meal Plan</a>
    </div>

</div>
{% endblock %}