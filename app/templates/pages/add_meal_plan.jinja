{% extends 'pages/_base.jinja' %}

{% block content %}

<h1>Add Meal to Meal Plan</h1>

<form method="POST" action="/meal_plan">

    <p>
        <label for="date">Date</label>
        <input
            type="date"
            id="date"
            name="date"
            required
        >
    </p>

    <p>
        <label for="meal_type">Meal Type</label>

        <select
            id="meal_type"
            name="meal_type"
            required
        >
            <option value="">Choose a meal type</option>
            <option value="breakfast">Breakfast</option>
            <option value="lunch">Lunch</option>
            <option value="dinner">Dinner</option>
        </select>
    </p>

    <p>
        <label for="recipe_id">Recipe</label>

        <select
            id="recipe_id"
            name="recipe_id"
            required
        >
            <option value="">Choose a recipe</option>

            {% for recipe in recipes %}

                <option value="{{ recipe.id }}">
                    {{ recipe.title }}
                </option>

            {% endfor %}

        </select>
    </p>

    <button type="submit">
        Add Meal
    </button>

</form>

<p>
    <a href="/meal_plan">Back to Meal Plan</a>
</p>

{% endblock %}